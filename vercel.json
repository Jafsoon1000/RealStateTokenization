{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "server/server.js" },
    { "source": "/assets/(.*)", "destination": "client/assets/$1" },
    { "source": "/images/(.*)", "destination": "client/images/$1" },
    { "source": "/favicon.ico", "destination": "client/favicon.ico" },
    { "source": "/((?!api|assets|images|favicon.ico).*)", "destination": "client/index.html" }
  ]
}
